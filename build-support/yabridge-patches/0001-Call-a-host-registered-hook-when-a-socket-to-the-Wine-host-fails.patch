+/**
+ * Merlin patch: the host application can register a function that is
+ * called when a socket to the Wine host fails (the host process died). Without
+ * it the failure surfaces as a C++ exception thrown through the host
+ * application's own frames, which aborts hosts that cannot catch C++
+ * exceptions. The hook may never return (it can restart the application).
+ */
+extern "C" {
+__attribute__((visibility("default"))) inline void (
+    *yabridge_socket_failed_hook)(void) = nullptr;
+}
+
+inline void notify_socket_failed() {
+    if (auto hook = yabridge_socket_failed_hook) {
+        hook();
+    }
+}
