 /* IDXGISwapChain1 methods */
 
+static void __stdcall composition_shadow_destroyed(void *parent)
+{
+}
+
+static const struct wined3d_parent_ops composition_shadow_parent_ops =
+{
+    composition_shadow_destroyed,
+};
+
+/* Applications like JUCE's Direct2D renderer repaint only the dirty rectangles of a flip model
+ * swapchain and expect the compositor to keep the rest of the previous frame. wined3d does not
+ * keep the back buffer's old contents across a present, so the last composed frame is kept in a
+ * texture of our own: the freshly drawn dirty rectangles are copied into it, and the complete
+ * frame is copied back into the back buffer before it is presented. */
+static void d3d11_swapchain_compose(struct d3d11_swapchain *swapchain, const DXGI_PRESENT_PARAMETERS *parameters)
+{
+    struct wined3d_resource_desc desc;
+    struct wined3d_device_context *context;
+    struct wined3d_texture *back_buffer;
+    struct wined3d_device *device;
+    BOOL fresh = FALSE;
+    RECT full;
+
+    wined3d_mutex_lock();
+    device = wined3d_swapchain_get_device(swapchain->wined3d_swapchain);
+    context = wined3d_device_get_immediate_context(device);
+    back_buffer = wined3d_swapchain_get_back_buffer(swapchain->wined3d_swapchain, 0);
+    wined3d_resource_get_desc(wined3d_texture_get_resource(back_buffer), &desc);
+
+    if (!swapchain->composition_shadow || swapchain->composition_width != desc.width
+            || swapchain->composition_height != desc.height)
+    {
+        if (swapchain->composition_shadow)
+            wined3d_texture_decref(swapchain->composition_shadow);
+        swapchain->composition_shadow = NULL;
+        desc.bind_flags |= WINED3D_BIND_SHADER_RESOURCE;
+        if (FAILED(wined3d_texture_create(device, &desc, 1, 1, 0, NULL, NULL,
+                &composition_shadow_parent_ops, &swapchain->composition_shadow)))
+        {
+            ERR("Failed to create the composition shadow texture.\n");
+            wined3d_mutex_unlock();
+            return;
+        }
+        swapchain->composition_width = desc.width;
+        swapchain->composition_height = desc.height;
+        fresh = TRUE;
+    }
+
+    SetRect(&full, 0, 0, desc.width, desc.height);
+    if (fresh || !parameters || !parameters->DirtyRectsCount || !parameters->pDirtyRects)
+    {
+        wined3d_device_context_blt(context, swapchain->composition_shadow, 0, &full,
+                back_buffer, 0, &full, 0, NULL, WINED3D_TEXF_POINT);
+    }
+    else
+    {
+        unsigned int i;
+
+        for (i = 0; i < parameters->DirtyRectsCount; ++i)
+        {
+            RECT r = parameters->pDirtyRects[i];
+
+            if (!IntersectRect(&r, &r, &full))
+                continue;
+            wined3d_device_context_blt(context, swapchain->composition_shadow, 0, &r,
+                    back_buffer, 0, &r, 0, NULL, WINED3D_TEXF_POINT);
+        }
+    }
+    wined3d_device_context_blt(context, back_buffer, 0, &full,
+            swapchain->composition_shadow, 0, &full, 0, NULL, WINED3D_TEXF_POINT);
+    wined3d_mutex_unlock();
+}
