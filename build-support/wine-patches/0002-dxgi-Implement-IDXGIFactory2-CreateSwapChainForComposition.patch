diff -ruN a/dlls/dxgi/dxgi_private.h b/dlls/dxgi/dxgi_private.h
--- a/dlls/dxgi/dxgi_private.h
+++ b/dlls/dxgi/dxgi_private.h
@@ -186,8 +186,19 @@
     IDXGIOutput *target;
     LONG present_count;
     LONG in_set_fullscreen_state;
+
+    /* Swapchains created for composition (IDXGIFactory2::CreateSwapChainForComposition)
+     * have no window of their own. They are created on an internal hidden window, and when
+     * dcomp attaches them to a visual tree that targets an HWND, they present to that HWND. */
+    HWND composition_window;
+    HWND composition_target;
 };
 
+/* Private data dcomp sets on a composition swapchain to tell it which HWND to present to. */
+DEFINE_GUID(WINE_DXGI_COMPOSITION_TARGET, 0xc7d1c1ba, 0x4e0b, 0x4e7a, 0x8d, 0x3b, 0x6f, 0x6b, 0xd1, 0xc0, 0xa5, 0xf1);
+
+void d3d11_swapchain_set_composition_window(IDXGISwapChain1 *iface, HWND window);
+
 HRESULT d3d11_swapchain_init(struct d3d11_swapchain *swapchain, struct dxgi_device *device,
         struct wined3d_swapchain_desc *desc, const DXGI_SWAP_CHAIN_FULLSCREEN_DESC *fullscreen_desc);
 
diff -ruN a/dlls/dxgi/factory.c b/dlls/dxgi/factory.c
--- a/dlls/dxgi/factory.c
+++ b/dlls/dxgi/factory.c
@@ -390,10 +390,64 @@
 static HRESULT STDMETHODCALLTYPE dxgi_factory_CreateSwapChainForComposition(IWineDXGIFactory *iface,
         IUnknown *device, const DXGI_SWAP_CHAIN_DESC1 *desc, IDXGIOutput *output, IDXGISwapChain1 **swapchain)
 {
-    FIXME("iface %p, device %p, desc %p, output %p, swapchain %p stub!\n",
+    DXGI_SWAP_CHAIN_FULLSCREEN_DESC fullscreen_desc = {0};
+    IWineDXGISwapChainFactory *swapchain_factory;
+    HRESULT hr;
+    HWND window;
+
+    TRACE("iface %p, device %p, desc %p, output %p, swapchain %p.\n",
             iface, device, desc, output, swapchain);
 
-    return E_NOTIMPL;
+    if (!device || !desc || !swapchain)
+    {
+        WARN("Invalid pointer.\n");
+        return DXGI_ERROR_INVALID_CALL;
+    }
+
+    if (desc->Stereo)
+    {
+        FIXME("Stereo swapchains are not supported.\n");
+        return DXGI_ERROR_UNSUPPORTED;
+    }
+
+
+    if (!dxgi_validate_swapchain_desc(desc))
+        return DXGI_ERROR_INVALID_CALL;
+
+    if (SUCCEEDED(IUnknown_QueryInterface(device, &IID_IWineDXGISwapChainFactory, (void **)&swapchain_factory)))
+    {
+        /* There is no window to render to until a composition visual tree is attached to an
+         * HWND, so the swapchain is created on an internal hidden window and presents to the
+         * real target later (see WINE_DXGI_COMPOSITION_TARGET). */
+        window = CreateWindowExW(0, L"Static", NULL, WS_POPUP, 0, 0,
+                max(desc->Width, 1), max(desc->Height, 1), NULL, NULL, NULL, NULL);
+        if (!window)
+        {
+            ERR("Failed to create the composition window.\n");
+            IWineDXGISwapChainFactory_Release(swapchain_factory);
+            return DXGI_ERROR_UNSUPPORTED;
+        }
+        fullscreen_desc.Windowed = TRUE;
+        hr = IWineDXGISwapChainFactory_create_swapchain(swapchain_factory,
+                (IDXGIFactory *)iface, window, desc, &fullscreen_desc, output, swapchain);
+        IWineDXGISwapChainFactory_Release(swapchain_factory);
+        if (FAILED(hr))
+        {
+            DestroyWindow(window);
+            return hr;
+        }
+        d3d11_swapchain_set_composition_window(*swapchain, window);
+        /* Applications repaint only the dirty rectangles of a flip model swapchain and rely
+         * on the compositor keeping the rest of the previous frame on screen. wined3d
+         * rotates multiple back buffers, so the "next" buffer would hold an older frame.
+         * One persistent buffer, presented whole, gives the same result. */
+        if (FAILED(hr = IDXGISwapChain1_ResizeBuffers(*swapchain, 1, 0, 0, DXGI_FORMAT_UNKNOWN, desc->Flags)))
+            WARN("Failed to switch to a single back buffer, hr %#lx.\n", hr);
+        return S_OK;
+    }
+
+    FIXME("Composition swapchains are only supported for d3d11 devices.\n");
+    return DXGI_ERROR_UNSUPPORTED;
 }
 
