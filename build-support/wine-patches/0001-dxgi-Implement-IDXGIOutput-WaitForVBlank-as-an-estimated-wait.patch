 static HRESULT STDMETHODCALLTYPE dxgi_output_WaitForVBlank(IDXGIOutput6 *iface)
 {
-    static BOOL once = FALSE;
+    struct dxgi_output *output = impl_from_IDXGIOutput6(iface);
+    enum wined3d_display_rotation rotation;
+    struct wined3d_display_mode mode;
+    LARGE_INTEGER freq, now;
+    LONGLONG period, target;
+    UINT refresh_rate;
+    HRESULT hr;
 
-    if (!once++)
-        FIXME("iface %p stub!\n", iface);
-    else
-        TRACE("iface %p stub!\n", iface);
+    TRACE("iface %p semi-stub!\n", iface);
 
-    return E_NOTIMPL;
+    /* There is no real vblank event to wait for, so estimate one: sleep until
+     * the next multiple of the refresh period on the performance counter.
+     * wined3d_output_get_raster_status() fakes the vblank the same way.
+     * Applications such as JUCE drive all their repainting from this call. */
+    wined3d_mutex_lock();
+    hr = wined3d_output_get_display_mode(output->wined3d_output, &mode, &rotation);
+    wined3d_mutex_unlock();
+    if (FAILED(hr))
+    {
+        WARN("Failed to get output display mode, hr %#lx.\n", hr);
+        return hr;
+    }
+
+    refresh_rate = mode.refresh_rate;
+    if (refresh_rate <= 1 || refresh_rate > 1000)
+        refresh_rate = 60;
+
+    QueryPerformanceFrequency(&freq);
+    QueryPerformanceCounter(&now);
+    period = freq.QuadPart / refresh_rate;
+    target = (now.QuadPart / period + 1) * period;
+
+    /* Round up to whole milliseconds; the jitter is irrelevant for repainting. */
+    Sleep((target - now.QuadPart) * 1000 / freq.QuadPart + 1);
+
+    return S_OK;
 }
 
